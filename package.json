{
  "name": "x-feed-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config vite.site.config.ts --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:site": "vite build --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "release": "npm run build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.0",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  }
}
