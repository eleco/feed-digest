{
  "buildCommand": "npm run build:site",
  "outputDirectory": "site-dist",
  "framework": "vite",
  "functions": { "api/reader.ts": { "includeFiles": "site-dist/reader.html" } },
  "rewrites": [{ "source": "/reader", "destination": "/api/reader" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    }
  ]
}
