# Server-only Basic Auth for /reader and /api/reader.
# Choose your own password; never use VITE_ prefixes for these values.
READER_USERNAME=reader
READER_PASSWORD=

# Production: connect a private Vercel Blob store to the Vercel project.
# Vercel supplies BLOB_STORE_ID (OIDC), or use BLOB_READ_WRITE_TOKEN.
# Local npm run dev uses .reader-data/ instead and needs no Blob account.
